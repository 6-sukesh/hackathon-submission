CLICKHOUSE_URL=http://localhost:8123
# Read-only app user (clickhouse/init/04-security.sql); row policies scope it to the token's tenant.
CLICKHOUSE_USER=analytics_app
CLICKHOUSE_PASSWORD=analytics_app_pw
CLICKHOUSE_DB=music
PORT=3000
# HS256 signing key for API tokens (>= 32 chars). Local-dev value; use a real secret anywhere shared.
JWT_SECRET=local-dev-only-jwt-secret-change-me-0123456789
